# Copy to local-inputs.env and edit. Do not commit local-inputs.env when it
# contains personal paths, credentials, proprietary files or signing data.

export UNIXNU_DIR="${UNIXNU_DIR:-../UniXNU}"
export UNIXNU_EDK2="${UNIXNU_EDK2:-../Mu-Silicium/Mu_Basecore}"
export MEIZU_BASELINE_DIR="${MEIZU_BASELINE_DIR:-../meizu-baseline}"
export MEIZU_BASELINE_BOOT="${MEIZU_BASELINE_BOOT:-$MEIZU_BASELINE_DIR/uefi-r19-clean-boot.img}"
export MEIZU_BASELINE_SPLASH="${MEIZU_BASELINE_SPLASH:-$MEIZU_BASELINE_DIR/SplashFbDxe-r19.efi}"
export MKB00TIMG="${MKB00TIMG:-../Mu-Silicium/Resources/Scripts/mkbootimg.py}"
export CLANG_BIN="${CLANG_BIN:-/usr/lib/llvm-18/bin/}"
export MEIZU_JOBS="${MEIZU_JOBS:-4}"
export MEIZU_QEMU_TIMEOUT="${MEIZU_QEMU_TIMEOUT:-45}"
